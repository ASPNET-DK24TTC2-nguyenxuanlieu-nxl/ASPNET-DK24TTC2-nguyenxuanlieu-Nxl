@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container my-5">
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto text-center">
            <h1 class="fw-bold mb-3">Về Apple Store Vietnam</h1>
            <p class="lead text-muted">Đối tác ủy quyền chính thức của Apple tại Việt Nam</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-center mb-3">
                        <i class="fas fa-store fa-3x text-primary"></i>
                    </div>
                    <h4 class="card-title text-center">Về chúng tôi</h4>
                    <p class="card-text">
                        Apple Store Vietnam là đối tác ủy quyền chính thức của Apple tại Việt Nam. 
                        Chúng tôi cam kết mang đến cho khách hàng những sản phẩm Apple chính hãng 
                        với giá cả cạnh tranh nhất và dịch vụ hậu mãi tốt nhất.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-center mb-3">
                        <i class="fas fa-award fa-3x text-primary"></i>
                    </div>
                    <h4 class="card-title text-center">Cam kết chất lượng</h4>
                    <p class="card-text">
                        100% sản phẩm chính hãng được nhập khẩu trực tiếp từ Apple. 
                        Bảo hành chính hãng 12 tháng tại tất cả các trung tâm bảo hành Apple 
                        trên toàn quốc. Đổi trả trong vòng 14 ngày nếu có lỗi từ nhà sản xuất.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-4">
                        <i class="fas fa-bullseye text-primary"></i> Sứ mệnh của chúng tôi
                    </h4>
                    <p>
                        Mang đến trải nghiệm mua sắm sản phẩm Apple tốt nhất cho khách hàng Việt Nam. 
                        Chúng tôi không chỉ bán sản phẩm mà còn cung cấp dịch vụ tư vấn chuyên nghiệp, 
                        hỗ trợ kỹ thuật và chăm sóc khách hàng tận tâm.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-12">
            <h3 class="fw-bold text-center mb-4">Tại sao chọn chúng tôi?</h3>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <div class="text-center p-3">
                        <i class="fas fa-shield-alt fa-3x text-primary mb-3"></i>
                        <h5>Chính hãng 100%</h5>
                        <p class="text-muted small">Sản phẩm Apple chính hãng, tem nhập khẩu đầy đủ</p>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="text-center p-3">
                        <i class="fas fa-shipping-fast fa-3x text-primary mb-3"></i>
                        <h5>Giao hàng nhanh</h5>
                        <p class="text-muted small">Miễn phí giao hàng toàn quốc cho đơn từ 5 triệu</p>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="text-center p-3">
                        <i class="fas fa-tools fa-3x text-primary mb-3"></i>
                        <h5>Bảo hành tốt</h5>
                        <p class="text-muted small">Bảo hành 12 tháng, hỗ trợ kỹ thuật 24/7</p>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="text-center p-3">
                        <i class="fas fa-credit-card fa-3x text-primary mb-3"></i>
                        <h5>Trả góp 0%</h5>
                        <p class="text-muted small">Hỗ trợ trả góp 0% lãi suất qua thẻ tín dụng</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card bg-primary text-white shadow-lg">
                <div class="card-body text-center p-5">
                    <h3 class="mb-3">Liên hệ với chúng tôi</h3>
                    <p class="mb-4">Chúng tôi luôn sẵn sàng hỗ trợ bạn!</p>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <i class="fas fa-phone fa-2x mb-2"></i>
                            <p class="mb-0"><strong>Hotline</strong></p>
                            <p>1900-xxxx</p>
                        </div>
                        <div class="col-md-4 mb-3">
                            <i class="fas fa-envelope fa-2x mb-2"></i>
                            <p class="mb-0"><strong>Email</strong></p>
                            <p>support@applestore.vn</p>
                        </div>
                        <div class="col-md-4 mb-3">
                            <i class="fas fa-map-marker-alt fa-2x mb-2"></i>
                            <p class="mb-0"><strong>Địa chỉ</strong></p>
                            <p>Hà Nội, Việt Nam</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
