@model List<Shopbanhangapple.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container-fluid my-4">
    <div class="row mb-4">
        <div class="col">
            <h1><i class="fas fa-box"></i> Quản lý sản phẩm</h1>
        </div>
        <div class="col text-end">
            <a href="/Admin/Products/Create" class="btn btn-apple">
                <i class="fas fa-plus"></i> Thêm sản phẩm mới
            </a>
            <a href="/Admin" class="btn btn-apple-outline">
                <i class="fas fa-arrow-left"></i> Quay lại Dashboard
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Hình ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th>Giá</th>
                                <th>Tồn kho</th>
                                <th>Tùy chỉnh</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>@product.Id</td>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder.jpg" : product.ImageUrl)" 
                                             alt="@product.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" />
                                    </td>
                                    <td>
                                        <strong>@product.Name</strong><br/>
                                        <small class="text-muted">@product.Description</small>
                                    </td>
                                    <td>@product.Category?.Name</td>
                                    <td><strong>@product.Price.ToString("N0") đ</strong></td>
                                    <td>
                                        @if (product.Stock < 10)
                                        {
                                            <span class="badge bg-danger">@product.Stock</span>
                                        }
                                        else if (product.Stock < 20)
                                        {
                                            <span class="badge bg-warning">@product.Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@product.Stock</span>
                                        }
                                    </td>
                                    <td>
                                        @if (product.IsCustomizable)
                                        {
                                            <i class="fas fa-check text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-times text-muted"></i>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="/Admin/Products/Edit/@product.Id" class="btn btn-sm btn-apple-outline">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="/Admin/Products/Delete/@product.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
            <h3>Chưa có sản phẩm nào</h3>
            <p class="text-muted">Hãy thêm sản phẩm đầu tiên của bạn!</p>
            <a href="/Admin/Products/Create" class="btn btn-apple mt-3">
                <i class="fas fa-plus"></i> Thêm sản phẩm mới
            </a>
        </div>
    }
</div>
