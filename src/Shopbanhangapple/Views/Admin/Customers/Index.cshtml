@model List<Shopbanhangapple.Controllers.Admin.CustomerViewModel>
@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users"></i> Quản lý khách hàng</h2>
        <a href="/Admin" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại Dashboard
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Vai trò</th>
                            <th>Xác thực Email</th>
                            <th>Số đơn hàng</th>
                            <th>Tổng chi tiêu</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>
                                    <i class="fas fa-envelope text-muted"></i>
                                    @customer.Email
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(customer.PhoneNumber))
                                    {
                                        <i class="fas fa-phone text-muted"></i>
                                        @customer.PhoneNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa cập nhật</span>
                                    }
                                </td>
                                <td>
                                    @if (customer.Roles.Contains("Admin"))
                                    {
                                        <span class="badge bg-danger">@customer.Roles</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">@customer.Roles</span>
                                    }
                                </td>
                                <td>
                                    @if (customer.EmailConfirmed)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check"></i> Đã xác thực
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">
                                            <i class="fas fa-exclamation"></i> Chưa xác thực
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info">@customer.OrderCount đơn</span>
                                </td>
                                <td>
                                    <strong class="text-primary">@customer.TotalSpent.ToString("N0") đ</strong>
                                </td>
                                <td>
                                    <a href="/Admin/Customers/Details/@customer.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Chưa có khách hàng nào</p>
                </div>
            }
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-primary">@Model.Count</h3>
                    <p class="text-muted mb-0">Tổng khách hàng</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-success">@Model.Count(c => c.OrderCount > 0)</h3>
                    <p class="text-muted mb-0">Đã mua hàng</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-info">@Model.Sum(c => c.OrderCount)</h3>
                    <p class="text-muted mb-0">Tổng đơn hàng</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="text-warning">@Model.Sum(c => c.TotalSpent).ToString("N0") đ</h3>
                    <p class="text-muted mb-0">Tổng doanh thu</p>
                </div>
            </div>
        </div>
    </div>
</div>
