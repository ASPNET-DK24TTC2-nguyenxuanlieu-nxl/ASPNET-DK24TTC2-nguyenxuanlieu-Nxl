@model Shopbanhangapple.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="container my-4">
    <div class="row mb-4">
        <div class="col">
            <h1><i class="fas fa-file-invoice"></i> Chi tiết đơn hàng #@Model.Id</h1>
            <p class="text-muted">Đặt ngày @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="col text-end">
            @if (Model.Status == "Đã đặt hàng")
            {
                <span class="order-status placed">@Model.Status</span>
            }
            else if (Model.Status == "Đang vận chuyển")
            {
                <span class="order-status shipping">@Model.Status</span>
            }
            else
            {
                <span class="order-status delivered">@Model.Status</span>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Order Items -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fas fa-box"></i> Sản phẩm</h5>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Cấu hình</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>
                                            <strong>@detail.Product?.Name</strong>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(detail.Configuration))
                                            {
                                                <small class="text-muted">@detail.Configuration</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">Mặc định</small>
                                            }
                                        </td>
                                        <td>@detail.Quantity</td>
                                        <td>@detail.Price.ToString("N0") đ</td>
                                        <td><strong>@((detail.Price * detail.Quantity).ToString("N0")) đ</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Shipping Information -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fas fa-shipping-fast"></i> Thông tin giao hàng</h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Địa chỉ giao hàng:</dt>
                        <dd class="col-sm-8">@Model.ShippingAddress</dd>

                        <dt class="col-sm-4">Phương thức thanh toán:</dt>
                        <dd class="col-sm-8">@Model.PaymentMethod</dd>

                        <dt class="col-sm-4">Khách hàng:</dt>
                        <dd class="col-sm-8">@Model.UserId</dd>
                    </dl>
                </div>
            </div>

            <!-- Update Status -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fas fa-sync"></i> Cập nhật trạng thái</h5>
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="row align-items-end">
                            <div class="col-md-8">
                                <label for="status" class="form-label">Trạng thái mới</label>
                                <select name="status" id="status" class="form-select">
                                    <option value="Đã đặt hàng" selected="@(Model.Status == "Đã đặt hàng")">Đã đặt hàng</option>
                                    <option value="Đang vận chuyển" selected="@(Model.Status == "Đang vận chuyển")">Đang vận chuyển</option>
                                    <option value="Đã giao hàng" selected="@(Model.Status == "Đã giao hàng")">Đã giao hàng</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-apple w-100">
                                    <i class="fas fa-save"></i> Cập nhật
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Order Summary -->
            <div class="cart-summary">
                <h5 class="mb-4"><i class="fas fa-calculator"></i> Tóm tắt đơn hàng</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span>Tạm tính:</span>
                    <strong>@Model.TotalAmount.ToString("N0") đ</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Phí vận chuyển:</span>
                    <strong>Miễn phí</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-4">
                    <h5>Tổng cộng:</h5>
                    <h5 class="text-primary">@Model.TotalAmount.ToString("N0") đ</h5>
                </div>

                <div class="d-grid gap-2">
                    <a href="/Admin/Orders" class="btn btn-apple-outline">
                        <i class="fas fa-arrow-left"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
