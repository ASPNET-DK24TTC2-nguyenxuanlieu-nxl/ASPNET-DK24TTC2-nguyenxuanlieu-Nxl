@model List<Shopbanhangapple.Models.Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid my-4">
    <div class="row mb-4">
        <div class="col">
            <h1><i class="fas fa-shopping-cart"></i> Quản lý đơn hàng</h1>
        </div>
        <div class="col text-end">
            <a href="/Admin" class="btn btn-apple-outline">
                <i class="fas fa-arrow-left"></i> Quay lại Dashboard
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Ngày đặt</th>
                                <th>Khách hàng</th>
                                <th>Số SP</th>
                                <th>Tổng tiền</th>
                                <th>Thanh toán</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><strong>#@order.Id</strong></td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@order.UserId</td>
                                    <td>@order.OrderDetails.Sum(od => od.Quantity)</td>
                                    <td><strong>@order.TotalAmount.ToString("N0") đ</strong></td>
                                    <td>
                                        <small class="text-muted">@order.PaymentMethod</small>
                                    </td>
                                    <td>
                                        @if (order.Status == "Đã đặt hàng")
                                        {
                                            <span class="order-status placed">@order.Status</span>
                                        }
                                        else if (order.Status == "Đang vận chuyển")
                                        {
                                            <span class="order-status shipping">@order.Status</span>
                                        }
                                        else
                                        {
                                            <span class="order-status delivered">@order.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Admin/Orders/Details/@order.Id" class="btn btn-sm btn-apple-outline">
                                            <i class="fas fa-eye"></i> Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-cart fa-4x text-muted mb-3"></i>
            <h3>Chưa có đơn hàng nào</h3>
            <p class="text-muted">Đơn hàng sẽ hiển thị ở đây khi khách hàng đặt hàng.</p>
        </div>
    }
</div>
