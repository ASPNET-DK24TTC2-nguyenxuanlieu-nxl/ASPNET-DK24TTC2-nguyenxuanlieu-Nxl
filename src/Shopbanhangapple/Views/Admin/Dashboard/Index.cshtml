@model List<Shopbanhangapple.Models.Order>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid my-4">
    <div class="row mb-4">
        <div class="col">
            <h1><i class="fas fa-tachometer-alt"></i> Admin Dashboard</h1>
            <p class="text-muted">Tổng quan hệ thống quản lý Apple Store</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="admin-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <h3>@ViewBag.TotalProducts</h3>
                <p><i class="fas fa-box"></i> Tổng sản phẩm</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <h3>@ViewBag.TotalOrders</h3>
                <p><i class="fas fa-shopping-cart"></i> Tổng đơn hàng</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <h3>@ViewBag.TotalRevenue.ToString("N0") đ</h3>
                <p><i class="fas fa-dollar-sign"></i> Tổng doanh thu</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-card" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                <h3>@ViewBag.PendingOrders</h3>
                <p><i class="fas fa-clock"></i> Đơn chờ xử lý</p>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fas fa-bolt"></i> Thao tác nhanh</h5>
                    <div class="row">
                        <div class="col-md-3 mb-2">
                            <a href="/Admin/Products" class="btn btn-apple w-100">
                                <i class="fas fa-box"></i> Quản lý sản phẩm
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="/Admin/Products/Create" class="btn btn-apple-outline w-100">
                                <i class="fas fa-plus"></i> Thêm sản phẩm mới
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="/Admin/Orders" class="btn btn-apple-outline w-100">
                                <i class="fas fa-shopping-cart"></i> Quản lý đơn hàng
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a href="/Admin/Customers" class="btn btn-outline-primary w-100">
                                <i class="fas fa-users"></i> Quản lý khách hàng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock Alert -->
    @if (ViewBag.LowStockProducts > 0)
    {
        <div class="alert alert-warning mb-4">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Cảnh báo:</strong> Có @ViewBag.LowStockProducts sản phẩm sắp hết hàng (dưới 10 sản phẩm).
            <a href="/Admin/Products" class="alert-link">Xem ngay</a>
        </div>
    }

    <!-- Recent Orders -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fas fa-history"></i> Đơn hàng gần đây</h5>
                    
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Mã đơn</th>
                                        <th>Ngày đặt</th>
                                        <th>Số lượng SP</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td><strong>#@order.Id</strong></td>
                                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@order.OrderDetails.Sum(od => od.Quantity)</td>
                                            <td>@order.TotalAmount.ToString("N0") đ</td>
                                            <td>
                                                @if (order.Status == "Đã đặt hàng")
                                                {
                                                    <span class="order-status placed">@order.Status</span>
                                                }
                                                else if (order.Status == "Đang vận chuyển")
                                                {
                                                    <span class="order-status shipping">@order.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="order-status delivered">@order.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="/Admin/Orders/Details/@order.Id" class="btn btn-sm btn-apple-outline">
                                                    Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">Chưa có đơn hàng nào.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
