@model Shopbanhangapple.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="container my-5">
    <div class="row mb-4">
        <div class="col">
            <h1>Đơn hàng #@Model.Id</h1>
            <p class="text-muted">Đặt ngày @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="col text-end">
            @if (Model.Status == "Đã đặt hàng")
            {
                <span class="badge bg-warning">@Model.Status</span>
            }
            else if (Model.Status == "Đang vận chuyển")
            {
                <span class="badge bg-info">@Model.Status</span>
            }
            else
            {
                <span class="badge bg-success">@Model.Status</span>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">Sản phẩm</h5>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Cấu hình</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>@detail.Product?.Name</td>
                                        <td>@detail.Configuration</td>
                                        <td>@detail.Quantity</td>
                                        <td>@detail.Price.ToString("N0") đ</td>
                                        <td>@((detail.Price * detail.Quantity).ToString("N0")) đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Thông tin giao hàng</h5>
                    <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
                    <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-4">Tóm tắt đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính:</span>
                        <strong>@Model.TotalAmount.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Phí vận chuyển:</span>
                        <strong class="text-success">Miễn phí</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <h5>Tổng cộng:</h5>
                        <h5 class="text-primary">@Model.TotalAmount.ToString("N0") đ</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a href="/Orders" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách đơn hàng
        </a>
    </div>
</div>
