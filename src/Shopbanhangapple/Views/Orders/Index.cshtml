@model List<Shopbanhangapple.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container my-5">
    <h1 class="mb-4">Đơn hàng của tôi</h1>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Mã đơn hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Phương thức thanh toán</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@order.TotalAmount.ToString("N0") đ</td>
                            <td>
                                @if (order.Status == "Đã đặt hàng")
                                {
                                    <span class="badge bg-warning">@order.Status</span>
                                }
                                else if (order.Status == "Đang vận chuyển")
                                {
                                    <span class="badge bg-info">@order.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@order.Status</span>
                                }
                            </td>
                            <td>@order.PaymentMethod</td>
                            <td>
                                <a href="/Orders/Details/@order.Id" class="btn btn-sm btn-outline-primary">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box fa-4x text-muted mb-3"></i>
            <h3>Chưa có đơn hàng nào</h3>
            <p class="text-muted">Hãy bắt đầu mua sắm ngay hôm nay!</p>
            <a href="/Products" class="btn btn-primary mt-3">
                Khám phá sản phẩm
            </a>
        </div>
    }
</div>
