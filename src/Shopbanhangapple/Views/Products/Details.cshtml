@model Shopbanhangapple.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="container my-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Products">Sản phẩm</a></li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/600x600?text=No+Image" : Model.ImageUrl)" 
                     alt="@Model.Name" class="card-img-top" style="max-height: 500px; object-fit: contain;">
            </div>
        </div>
        
        <div class="col-lg-6">
            <span class="badge bg-secondary mb-2">@Model.Category?.Name</span>
            <h1 class="fw-bold mb-3">@Model.Name</h1>
            <p class="lead text-muted">@Model.Description</p>
            
            <div class="card bg-light mb-3">
                <div class="card-body">
                    <h2 class="text-primary mb-0">@Model.Price.ToString("N0") đ</h2>
                </div>
            </div>
            
            @if (Model.Stock > 0)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> <strong>Còn hàng:</strong> @Model.Stock sản phẩm
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <i class="fas fa-times-circle"></i> <strong>Hết hàng</strong>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.TechnicalSpecs))
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-info-circle"></i> Thông số kỹ thuật</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">@Model.TechnicalSpecs</p>
                    </div>
                </div>
            }

            @if (Model.IsCustomizable && Model.Configurations != null && Model.Configurations.Any())
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-cog"></i> Tùy chỉnh cấu hình</h5>
                    </div>
                    <div class="card-body">
                        <form action="/Cart/AddToCart" method="post" id="configForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="hidden" name="configuration" id="finalConfiguration" value="" />
                            
                            @foreach (var configGroup in Model.Configurations.GroupBy(c => c.OptionType))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">@configGroup.Key</label>
                                    @foreach (var config in configGroup)
                                    {
                                        <div class="form-check">
                                            <input type="radio" 
                                                   name="option_@configGroup.Key.Replace(" ", "_")" 
                                                   value="@config.OptionValue" 
                                                   data-option-type="@config.OptionType"
                                                   data-price="@config.PriceAdjustment"
                                                   id="config_@config.Id" 
                                                   class="form-check-input config-option" />
                                            <label for="config_@config.Id" class="form-check-label">
                                                @config.OptionValue 
                                                @if (config.PriceAdjustment > 0)
                                                {
                                                    <span class="text-muted">(+@config.PriceAdjustment.ToString("N0") đ)</span>
                                                }
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                            
                            <div class="alert alert-info" id="selectedConfig" style="display:none;">
                                <strong>Cấu hình đã chọn:</strong> <span id="configText"></span>
                            </div>
                            
                            <button type="submit" class="btn btn-primary btn-lg w-100" @(Model.Stock <= 0 ? "disabled" : "")>
                                <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
                            </button>
                        </form>
                    </div>
                </div>
                
                <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const form = document.getElementById('configForm');
                    const configOptions = document.querySelectorAll('.config-option');
                    const finalConfig = document.getElementById('finalConfiguration');
                    const selectedConfigDiv = document.getElementById('selectedConfig');
                    const configText = document.getElementById('configText');
                    
                    function updateConfiguration() {
                        const selected = [];
                        configOptions.forEach(option => {
                            if (option.checked) {
                                const type = option.getAttribute('data-option-type');
                                const value = option.value;
                                selected.push(type + ': ' + value);
                            }
                        });
                        
                        if (selected.length > 0) {
                            finalConfig.value = selected.join(', ');
                            configText.textContent = selected.join(', ');
                            selectedConfigDiv.style.display = 'block';
                        } else {
                            finalConfig.value = '';
                            selectedConfigDiv.style.display = 'none';
                        }
                    }
                    
                    configOptions.forEach(option => {
                        option.addEventListener('change', updateConfiguration);
                    });
                    
                    form.addEventListener('submit', function(e) {
                        updateConfiguration();
                    });
                });
                </script>
            }
            else
            {
                <form action="/Cart/AddToCart" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary btn-lg w-100" @(Model.Stock <= 0 ? "disabled" : "")>
                        <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
                    </button>
                </form>
            }

            <div class="d-grid gap-2 mt-3">
                <a href="/Products" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
